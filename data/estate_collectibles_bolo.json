{
  "schema_version": "1.0",
  "domain": "estate_collectibles",
  "last_updated": "2026-05-04",
  "summary": "Lightweight high-resale collectibles common at estate auctions. Strict focus: items that ship in poly_mailer or small_box AND have a sustained collector market with $50+ average resale value. Sweet spot is signed costume jewelry (vintage 1940s-60s), premium figurines (Hummel, Lladró, Royal Doulton), pottery (Rookwood, Roseville, Hull, McCoy, Weller), glassware (Fenton, Imperial Candlewick, Heisey), and iconic vintage toys (Steiff, vintage Fisher-Price). Skips heavy pieces (large pottery vases >5 lbs, full china sets, large lamps) — these are physically too costly to ship for the typical $50-300 used-resale price point.",
  "field_workflow": [
    "Confirm SIGNATURE / hallmark on the piece — unsigned costume jewelry is commodity",
    "Pottery / figurines: photograph maker's mark on the bottom (Roseville, McCoy, Hummel #s)",
    "Glassware: hold against light to spot chips/cracks (deal-killer for collector-tier)",
    "Jewelry: gold-tone vs sterling matters HUGELY — verify '925' / 'sterling' stamp",
    "Hummel: TMK (trademark) number identifies era (TMK-1 = 1935-49, TMK-8 = 2000-2008)",
    "Royal Doulton character jugs: model letter+number (D6XXX series) + size (large/small/mini/tiny)",
    "Damaged / chipped / repaired pieces drop value 70-90% — disclose in listing",
    "Original box / paperwork / certificate adds 20-50% on premium pieces"
  ],
  "skip_list": [
    "Made in China (modern reproduction)",
    "Resin / plastic 'antique-style'",
    "Generic figurines",
    "Unsigned costume jewelry",
    "Damaged / chipped / cracked",
    "Repaired / glued",
    "Reproductions",
    "Large urns / lamps (too heavy)",
    "Full china sets (heavy + buyers want individual pieces)",
    "Mass-market modern Lenox / Mikasa (post-2000 commodity tier)"
  ],
