{
  "schema_version": "1.0",
  "domain": "auto_parts",
  "last_updated": "2026-05-04",
  "summary": "Automotive replacement parts and performance modifications. eBay is the dominant marketplace — buyers search by EXACT part number for their specific vehicle make/model/year. OEM-stamped parts (Bosch, Denso, ACDelco, Motorcraft, Mopar) trade at significant premium over aftermarket equivalents. Lightweight high-margin items: spark plugs, ignition coils, headlight assemblies, sensors, mirrors, switches. Heavy/large items (hoods, doors, tailgates) are unprofitable to ship — auction-only / pickup-only territory. Performance parts (Brembo brakes, Magnaflow exhaust, BBS wheels) have dedicated enthusiast markets with strong sustained demand.",
  "field_workflow": [
    "Verify part number on the part itself — listings live and die by SKU match",
    "OEM / Genuine / Original stamping = +50-100% over generic aftermarket",
    "Vehicle fitment: list specific year/make/model/engine/trim — buyers filter by this",
    "Test electronics (alternators, ignition coils, fuel injectors) when possible",
    "Brake rotors: measure thickness — below minimum spec = recycle, not resale",
    "Spark plugs: don't bother unless platinum / iridium / OEM-package new",
    "Headlight assemblies: check for clouding (yellowing) — premium examples are clear",
    "Heavy items (rotors, calipers, alternators): factor freight into pricing"
  ],
  "skip_list": [
    "Aftermarket no-name",
    "Generic clone",
    "Bent / damaged",
    "Cracked housings",
    "Chinese knockoff",
    "Pull-from-junkyard rusty",
    "Mismatched left/right pair",
    "DEPO (low-quality aftermarket lighting)",
    "TYC econo line",
    "Hot Wheels / die-cast (collector market, not parts)",
    "Toy car"
  ],
